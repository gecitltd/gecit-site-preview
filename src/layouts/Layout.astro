---
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  locale: 'tr' | 'en';
  title: string;
  description?: string;
  altHref: string;
}
const { locale, title, description, altHref } = Astro.props;
const desc = description ?? site.seo.description[locale];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content={site.seo.keywords} />
    <meta name="theme-color" content="#04101f" />
    <link rel="icon" href={withBase('/img/gecit-icon.png')} type="image/png" />
    {/* Runs before first paint so reveal-on-scroll styles only apply when there
        is JS to undo them. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {/* Only the display face is preloaded: it renders the LCP headline. Body
        text swaps in from the metric-matched fallback without layout shift. */}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
  </head>
  <body>
    <Nav locale={locale} altHref={altHref} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* Nav switches from transparent-over-hero to a solid blurred bar. */
      const nav = document.querySelector('.site-nav');
      const onScroll = () => nav?.classList.toggle('is-stuck', window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      /* Reveal-on-scroll. Elements stay visible once shown so re-scrolling the
         page doesn't re-animate content the visitor has already read. */
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduceMotion) {
        revealables.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              revealObserver.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        revealables.forEach((el) => revealObserver.observe(el));
      }

      /* Pointer-tracked spotlight on the company cards. */
      if (!reduceMotion && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll<HTMLElement>('.company-card').forEach((card) => {
          card.addEventListener('pointermove', (event) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
            card.style.setProperty('--my', `${event.clientY - rect.top}px`);
          });
        });
      }

      /* Highlights the nav link (home) or quicknav link (detail pages) whose
         section is currently in view.

         Driven by scroll position rather than an IntersectionObserver band: a
         fast wheel scroll moves further in one frame than a narrow band is
         tall, so an observer silently skips headings and nothing lights up. */
      function trackActive(links: NodeListOf<HTMLAnchorElement>) {
        const pairs: { link: HTMLAnchorElement; target: HTMLElement }[] = [];
        links.forEach((link) => {
          const id = link.hash.slice(1);
          if (!id) return;
          const target = document.getElementById(decodeURIComponent(id));
          if (target) pairs.push({ link, target });
        });
        if (pairs.length === 0) return;

        // A little below the nav, so a heading counts as current once it
        // reaches the top of the readable area.
        const line = 140;
        let queued = false;

        const update = () => {
          queued = false;
          let current: HTMLAnchorElement | null = null;
          for (const { link, target } of pairs) {
            if (target.getBoundingClientRect().top <= line) current = link;
          }
          links.forEach((l) => l.classList.toggle('is-active', l === current));
        };

        update();
        window.addEventListener(
          'scroll',
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
      }

      trackActive(document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href*="#"]'));
      trackActive(document.querySelectorAll<HTMLAnchorElement>('.quicknav a[href^="#"]'));
    </script>
  </body>
</html>
