---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import CompanyDetail from '../../components/CompanyDetail.astro';
import { getEnglishById } from '../../lib/companies';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'companies'>;
}
const { entry } = Astro.props;

const enById = await getEnglishById();
const altHref = enById[entry.id]
  ? getRelativeLocaleUrl('en', `/companies/${entry.id}/`)
  : getRelativeLocaleUrl('en', '/');
---

<Layout locale="tr" title={`${entry.data.name} — Geçit`} altHref={altHref}>
  <CompanyDetail entry={entry} locale="tr" />
</Layout>
