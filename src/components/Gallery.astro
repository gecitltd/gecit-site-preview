---
import { readFile } from 'node:fs/promises';
import sharp from 'sharp';
import { withBase } from '../lib/url';

interface Props {
  images: string[];
  alt: string;
  class?: string;
}
const { images, alt, class: className } = Astro.props;

// Natural pixel size per image, so the CSS can cap upscaling and pad the rest.
const sized = await Promise.all(
  images.map(async (src) => {
    try {
      const { width, height } = await sharp(await readFile(`public${src}`)).metadata();
      return { src, width: width ?? 0, height: height ?? 0 };
    } catch {
      return { src, width: 0, height: 0 };
    }
  }),
);
---

{
  images.length > 0 && (
    <div class:list={['gallery', className]}>
      {sized.map(({ src, width, height }) => (
        <img
          src={withBase(src)}
          alt={alt}
          loading="lazy"
          style={width && height ? `--nw:${width};--nh:${height}` : undefined}
        />
      ))}
    </div>
  )
}

<script>
  // Click-and-drag scrolling for mouse users; touch keeps native swiping.
  document.querySelectorAll<HTMLElement>('.gallery').forEach((el) => {
    let startX = 0;
    let startLeft = 0;
    let down = false;
    let moved = false;
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = el.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 4) {
        moved = true;
        el.classList.add('is-dragging');
      }
      if (moved) el.scrollLeft = startLeft - dx;
    });
    const end = () => {
      if (!down) return;
      down = false;
      el.classList.remove('is-dragging');
    };
    window.addEventListener('pointerup', end);
    window.addEventListener('pointercancel', end);
    el.addEventListener('dragstart', (e) => e.preventDefault());
  });
</script>
