---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  locale: 'tr' | 'en';
  altHref: string;
}
const { locale, altHref } = Astro.props;
const home = getRelativeLocaleUrl(locale, '/');
---

<header class="site-nav">
  <div class="nav-inner">
    <a class="brand" href={home}>
      <img src={withBase('/img/gecit-lockup.svg')} alt="Geçit" />
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menu"
    >
      ☰
    </button>
    <nav class="nav-links" id="primary-nav" aria-label="Primary">
      <a href={`${home}#glass`}>{site.nav.glass[locale]}</a>
      <a href={`${home}#ceramics`}>{site.nav.ceramics[locale]}</a>
      <a href={`${home}#contact`}>{site.nav.contact[locale]}</a>
      <a href={altHref} class="lang-switch">{site.nav.langSwitch[locale]}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.getElementById('primary-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  // Anchor links scroll within the page, so close the mobile menu on tap.
  links?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      links.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
