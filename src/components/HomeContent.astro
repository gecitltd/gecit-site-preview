---
import CompanyCard from './CompanyCard.astro';
import BrandMarquee from './BrandMarquee.astro';
import { site } from '../data/site';
import { getGroupedCompanies, getEnglishById, getCardProps } from '../lib/companies';
import { withBase } from '../lib/url';

interface Props {
  locale: 'tr' | 'en';
}
const { locale } = Astro.props;

const { hotEnd, coldEnd, ceramics } = await getGroupedCompanies();
const enById = await getEnglishById();

// Splits the headline around the accented substring so it can carry the
// gradient fill without hard-coding markup into the translated string.
const heading = site.hero.heading[locale];
const accent = site.hero.headingAccent[locale];
const accentAt = heading.indexOf(accent);
const headingParts =
  accentAt === -1
    ? { before: heading, accent: '', after: '' }
    : {
        before: heading.slice(0, accentAt),
        accent,
        after: heading.slice(accentAt + accent.length),
      };

const marqueeLogos = [...hotEnd, ...coldEnd, ...ceramics].map((entry) => ({
  src: entry.data.logo,
  name: entry.data.name,
}));
---

<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <h1>
        {headingParts.before}<span class="accent">{headingParts.accent}</span>{headingParts.after}
      </h1>
      <p>{site.hero.subheading[locale]}</p>
      <div class="hero-actions">
        <a class="hero-btn" href="#glass">
          {site.nav.glass[locale]}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="hero-btn" href="#ceramics">
          {site.nav.ceramics[locale]}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <BrandMarquee label={site.marqueeLabel[locale]} logos={marqueeLogos} />
  </div>
</section>

<section id="glass" class="section">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="section-eyebrow">{site.sectionEyebrows.glass[locale]}</p>
      <h2>{site.about.glass.title[locale]}</h2>
      <p>{site.about.glass.body[locale]}</p>
    </div>

    <h3 class="segment-heading is-hot" data-reveal>{site.glassSegments['hot-end'][locale]}</h3>
    <div class="card-grid">
      {
        hotEnd.map((entry, i) => {
          const card = getCardProps(entry, locale, enById);
          return (
            <CompanyCard
              href={card.href}
              logo={entry.data.logo}
              name={entry.data.name}
              blurb={card.blurb}
              external={card.external}
              index={i}
            />
          );
        })
      }
    </div>

    <h3 class="segment-heading" data-reveal>{site.glassSegments['cold-end'][locale]}</h3>
    <div class="card-grid">
      {
        coldEnd.map((entry, i) => {
          const card = getCardProps(entry, locale, enById);
          return (
            <CompanyCard
              href={card.href}
              logo={entry.data.logo}
              name={entry.data.name}
              blurb={card.blurb}
              external={card.external}
              index={i}
            />
          );
        })
      }
    </div>
  </div>
</section>

<section id="ceramics" class="section section-alt">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="section-eyebrow">{site.sectionEyebrows.ceramics[locale]}</p>
      <h2>{site.about.ceramics.title[locale]}</h2>
      <p>{site.about.ceramics.body[locale]}</p>
    </div>

    <div class="card-grid">
      {
        ceramics.map((entry, i) => {
          const card = getCardProps(entry, locale, enById);
          return (
            <CompanyCard
              href={card.href}
              logo={entry.data.logo}
              name={entry.data.name}
              blurb={card.blurb}
              external={card.external}
              index={i}
            />
          );
        })
      }
    </div>
  </div>
</section>

<section id="contact" class="section section-contact">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="section-eyebrow">{site.sectionEyebrows.contact[locale]}</p>
      <h2>{site.contact.title[locale]}</h2>
    </div>
    <div class="contact-grid">
      <div class="map-block" data-reveal>
        <a
          class="map-card"
          href={site.contact.directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={site.contact.labels.directions[locale]}
        >
          <img src={withBase(site.contact.mapImage)} alt="Geçit" loading="lazy" />
          <span class="map-card-cta">
            {site.contact.labels.directions[locale]}
            <span class="arrow" aria-hidden="true">↗</span>
          </span>
        </a>
        <a
          class="map-attribution"
          href="https://www.openstreetmap.org/copyright"
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.contact.mapAttribution[locale]}
        </a>
      </div>
      <div class="contact-details" data-reveal style="--reveal-delay: 1">
        <div class="row">
          <span class="contact-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="3" />
            </svg>
          </span>
          <span>{site.contact.addressLines.join(', ')}</span>
        </div>
        <div class="row">
          <span class="contact-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"
              />
            </svg>
          </span>
          <span>{site.contact.labels.phone[locale]}: {site.contact.phone}</span>
        </div>
        <div class="row">
          <span class="contact-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 6 2 18 2 18 9" />
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
              <rect x="6" y="14" width="12" height="8" />
            </svg>
          </span>
          <span>{site.contact.labels.fax[locale]}: {site.contact.fax}</span>
        </div>
        <div class="row">
          <span class="contact-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" />
            </svg>
          </span>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </div>
      </div>
    </div>
  </div>
</section>
